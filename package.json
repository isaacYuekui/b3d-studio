    "prebuild": "node scripts/fetch-assets.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "@babylonjs/loaders": "^8.56.2",
    "@babylonjs/serializers": "^8.56.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
